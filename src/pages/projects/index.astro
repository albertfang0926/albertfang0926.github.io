---
import { projectData } from '@/data/projects'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListProjects from '@/components/ListProjects.vue'
---

<BaseLayout title="项目" description="我的项目列表">
  {
    projectData.map((group) => (
      <fieldset class="project-group">
        <legend class="project-legend">{group.title}</legend>
        <ListProjects list={group.projects} />
      </fieldset>
    ))
  }
</BaseLayout>

<style>
  .project-group {
    width: 100%;
    margin: 0 0 1.4rem;
    padding: 0.2rem 1.2rem 1rem;
    border: 1px solid var(--line);
    min-width: 0;
  }

  .project-group:last-child {
    margin-bottom: 0;
  }

  .project-legend {
    padding: 0 0.6em;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
</style>
