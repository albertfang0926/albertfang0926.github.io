---
import BaseLayout from '@/layouts/BaseLayout.astro'
import siteConfig from '@/site-config'
import { getPosts, sortPostsByDate } from '@/utils/posts'

const [blogPosts, notesPosts, talksPosts] = await Promise.all([
  getPosts(undefined, 'blog'),
  getPosts(undefined, 'notes'),
  getPosts(undefined, 'talks'),
])
const recentPosts = [...blogPosts, ...notesPosts, ...talksPosts].sort(sortPostsByDate)
const lead = recentPosts[0]
const following = recentPosts.slice(1, 6)

const total = recentPosts.length
const earliest = recentPosts.reduce<string | null>(
  (min, post) => (min === null || post.data.date < min ? post.data.date : min),
  null,
)
const siteAge = earliest ? Math.floor((Date.now() - new Date(earliest).getTime()) / 86400000) + 1 : 0
const lastUpdate = recentPosts[0]?.data.date ?? ''

const github = siteConfig.socialLinks.filter((link) => link.href)[0]

const boards = [
  { name: '博客', desc: '技术成文', href: '/blog/blogs', count: blogPosts.length },
  {
    name: '随记',
    desc: notesPosts.length > 0 ? '短碎片' : '短碎片 · 虚位以待',
    href: '/blog/notes',
    count: notesPosts.length,
  },
  { name: '分享', desc: '对话与梳理', href: '/blog/talks', count: talksPosts.length },
  { name: '项目', desc: '造点小东西', href: '/projects', count: null },
]

function getPostHref(post: { data: { redirect?: string }; id: string }) {
  return post.data.redirect || `/posts/${post.id}`
}
const readTime = (duration?: string) => duration?.replace(/min/i, '分钟')
const postMeta = (post: (typeof recentPosts)[number]) =>
  [post.data.tag, readTime(post.data.duration)].filter(Boolean).join(' · ')
---

<BaseLayout description={siteConfig.description}>
  <style is:global>
    @font-face {
      font-family: 'JetBrains Mono Local';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url('/fonts/jetbrains-mono-latin-400.woff2') format('woff2');
    }
    @font-face {
      font-family: 'JetBrains Mono Local';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url('/fonts/jetbrains-mono-latin-700.woff2') format('woff2');
    }

    /* 整页进站：主页地面铺满视口，全局 chrome 落在同一张地面上（仅作用于含 .station 的页面）。
       背景与墨色用带 .dark 前缀的强选择器，压过模板 .dark 变体工具类的 (0,2,0) 特异性。 */
    html:not(.dark) body:has(.station),
    .dark body:has(.station) {
      --gutter: clamp(1rem, 4vw, 2.5rem);
      background: var(--ground);
      color: var(--ink);
    }
    html:not(.dark) body:has(.station) {
      --ground: #f3f2ec;
      --ink: #1c2438;
      --ink-soft: rgb(28 36 56 / 0.72);
      --ink-dim: rgb(28 36 56 / 0.68);
      --line: rgb(28 36 56 / 0.32);
      --line-strong: rgb(28 36 56 / 0.55);
      --accent: #0a6f68;
      --accent-2: #8f5a00;
      --cursor: rgb(10 111 104 / 0.16);
      --cursor-ink: var(--ink);
    }
    .dark body:has(.station) {
      --ground: #101830;
      --ink: #dfe6f3;
      --ink-soft: rgb(223 230 243 / 0.72);
      --ink-dim: rgb(223 230 243 / 0.62);
      --line: rgb(223 230 243 / 0.26);
      --line-strong: rgb(223 230 243 / 0.5);
      --accent: #52d9cf;
      --accent-2: #f0b45c;
      --cursor: var(--accent);
      --cursor-ink: var(--ground);
    }
    body:has(.station)::before {
      content: none;
    }
    body:has(.station) main {
      max-width: none;
      margin: 0;
      padding: 5.5rem 0 0;
    }
    body:has(.station) header,
    body:has(.station) footer,
    body:has(.station) .nav-drawer {
      font-family:
        'JetBrains Mono Local', ui-monospace, Consolas, 'Cascadia Mono', 'Courier New', 'PingFang SC',
        'Microsoft YaHei', monospace;
    }
    body:has(.station) header {
      padding-inline: var(--gutter);
      color: var(--ink-soft);
      font-size: 0.875rem;
    }
    body:has(.station) header .nav-link {
      color: var(--ink);
    }
    body:has(.station) header img {
      border-radius: 0;
      border: 1px solid var(--line-strong);
    }
    body:has(.station) .nav-drawer {
      background: var(--ground);
      font-size: 0.9375rem;
    }
    body:has(.station) footer {
      max-width: none;
      padding-inline: var(--gutter);
      border-top-color: var(--line);
      color: var(--ink-dim);
    }
    body:has(.station) footer .nav-link {
      color: var(--ink-dim);
    }
    html:not(.dark) body:has(.station) ::selection,
    .dark body:has(.station) ::selection {
      background: var(--accent);
      color: var(--ground);
    }
  </style>
  <div class="station">
    <div class="sysline">
      <span class="sys-title">AlbertFang's Blog <span class="sys-tag">【技术 · 生活】</span></span>
      <span class="sys-stat">文章 {total} 篇 · 站龄第 {siteAge} 天 · 最近更新 {lastUpdate}</span>
    </div>

    <div class="station-body">
      <fieldset class="gate">
        <legend class="gate-legend">进站</legend>
        <h1 class="station-name">AlbertFang's Blog</h1>
        <div class="sysop">
          <img
            class="sysop-photo"
            width="40"
            height="40"
            src={siteConfig.header.logo.src}
            alt={`${siteConfig.author} 的头像`}
            loading="eager"
          />
          <div class="sysop-info">
            <p class="sysop-line">站长 {siteConfig.author} · 一名开发者，也是生活的记录者。</p>
            <p class="sysop-contact">
              {
                github && (
                  <a class="menu-link" href={github.href} target="_blank" rel="noopener">
                    [GitHub]
                  </a>
                )
              }
              <a class="menu-link" href="/rss.xml" target="_blank">[RSS 订阅]</a>
              <a class="menu-link" href={`mailto:${siteConfig.email}`}>[写信给我]</a>
            </p>
          </div>
        </div>
        <p class="welcome">欢迎光临，请随意翻阅；文章不定期更新。</p>
      </fieldset>

      <div class="folio">
        <fieldset class="block block-main">
          <legend class="block-legend">最新张贴</legend>
          {
            lead && (
              <article class="lead">
                <h2 class="lead-title">
                  <a
                    class="row-link"
                    href={getPostHref(lead)}
                    target={lead.data.redirect ? '_blank' : '_self'}
                    rel={lead.data.redirect ? 'noopener' : undefined}
                  >
                    {lead.data.title}
                  </a>
                  {lead.data.draft && <span class="mark">[草稿]</span>}
                  {lead.data.redirect && <span class="mark">[外链]</span>}
                </h2>
                <p class="lead-meta">
                  <time datetime={lead.data.date}>{lead.data.date}</time>
                  <span> · 分享{lead.data.tag && ` · [${lead.data.tag}]`}</span>
                  {readTime(lead.data.duration) && <span> · 读时 {readTime(lead.data.duration)}</span>}
                </p>
                {lead.data.description && <p class="lead-desc">{lead.data.description}</p>}
                <p class="lead-more">
                  <a
                    class="read-link"
                    href={getPostHref(lead)}
                    target={lead.data.redirect ? '_blank' : '_self'}
                    rel={lead.data.redirect ? 'noopener' : undefined}
                  >
                    [阅读全文]
                  </a>
                </p>
              </article>
            )
          }
          {
            following.length > 0 && (
              <ol class="post-list">
                {following.map((post, index) => (
                  <li class="post-row">
                    <a
                      class="cursor-row"
                      href={getPostHref(post)}
                      target={post.data.redirect ? '_blank' : '_self'}
                      rel={post.data.redirect ? 'noopener' : undefined}
                    >
                      <span class="row-idx">{String(index + 2).padStart(2, '0')}</span>
                      <span class="row-title">
                        {post.data.title}
                        {post.data.draft && <span class="mark">[草稿]</span>}
                        {post.data.redirect && <span class="mark">[外链]</span>}
                      </span>
                      <time class="row-date" datetime={post.data.date}>
                        {post.data.date}
                      </time>
                      <span class="row-meta">{postMeta(post)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
        </fieldset>

        <nav class="block block-side" aria-label="版面导航">
          <fieldset class="block-inner">
            <legend class="block-legend">版面导航</legend>
            <ul class="board-list">
              {
                boards.map((board) => (
                  <li class="board-row">
                    <a class="board-item" href={board.href}>
                      <span class="board-line">
                        <span class="board-name">{board.name}</span>
                        <span class="board-count">{board.count === null ? '看看' : `${board.count} 篇`}</span>
                      </span>
                      <span class="board-desc">{board.desc}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </fieldset>
        </nav>
      </div>
    </div>

    <div class="statusbar">
      <span>在线 1 人 · 访客就是你</span>
      <span>纯静态小站 · 无需登录 · 欢迎常来</span>
    </div>
  </div>
</BaseLayout>

<style>
  .station {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    font-family:
      'JetBrains Mono Local', ui-monospace, Consolas, 'Cascadia Mono', 'Courier New', 'PingFang SC', 'Microsoft YaHei',
      monospace;
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .station-body {
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    padding: 0 var(--gutter) 1.4rem;
  }

  .station :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sysline {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0 var(--gutter) 0.55rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.8125rem;
  }
  .sys-title {
    font-weight: 700;
  }
  .sys-tag {
    color: var(--ink-soft);
    font-weight: 400;
  }
  .sys-stat {
    color: var(--ink-dim);
  }

  .gate {
    margin: 1.4rem 0 0;
    padding: 0.4rem 1.4rem 1.2rem;
    border: 3px double var(--line-strong);
  }
  .gate-legend,
  .block-legend {
    padding: 0 0.6em;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .station-name {
    margin: 0;
    padding-top: 0.6rem;
    font-size: clamp(1.7rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }
  .sysop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1rem;
  }
  .sysop-photo {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    border-radius: 0;
  }
  .sysop-line {
    margin: 0;
    color: var(--ink-soft);
  }
  .sysop-contact {
    margin: 0.15rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.875rem;
  }
  .menu-link {
    color: var(--accent);
    text-decoration: none;
  }
  .menu-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .welcome {
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  .folio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    gap: 1.2rem;
    margin-top: 1.4rem;
  }
  .block,
  .block-inner {
    margin: 0;
    padding: 0.2rem 1.2rem 1rem;
    border: 1px solid var(--line);
    min-width: 0;
  }
  .block-main {
    padding-bottom: 0.5rem;
  }

  .lead {
    padding: 0.6rem 0 0.4rem;
    border-bottom: 1px dashed var(--line);
  }
  .lead-title {
    margin: 0;
    font-size: clamp(1.35rem, 3.6vw, 1.8rem);
    font-weight: 700;
    line-height: 1.45;
  }
  .row-link {
    color: inherit;
    text-decoration: none;
  }
  .row-link:hover {
    color: var(--accent);
  }
  .mark {
    margin-left: 0.4em;
    font-size: 0.78em;
    font-weight: 400;
    color: var(--accent-2);
    white-space: nowrap;
  }
  .lead-meta {
    margin: 0.45rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }
  .lead-desc {
    margin: 0.7rem 0 0;
    max-width: 42em;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--ink-soft);
  }
  .lead-more {
    margin: 0.8rem 0 0;
    font-size: 0.875rem;
  }
  .read-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .read-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-row + .post-row {
    border-top: 1px solid var(--line);
  }
  .cursor-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5ch minmax(0, 1fr) 10ch minmax(0, 12ch);
    align-items: baseline;
    gap: 0 1.2ch;
    padding: 0.55rem 0.5rem 0.55rem 1.35rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cursor-row::before {
    content: '▸';
    position: absolute;
    left: 0.2rem;
    top: 0.55rem;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cursor-row:hover,
  .cursor-row:focus-visible {
    background: var(--cursor);
    color: var(--cursor-ink);
  }
  .cursor-row:hover .row-title,
  .cursor-row:hover .row-idx,
  .cursor-row:hover .row-date,
  .cursor-row:hover .row-meta,
  .cursor-row:hover .mark,
  .cursor-row:focus-visible .row-title,
  .cursor-row:focus-visible .row-idx,
  .cursor-row:focus-visible .row-date,
  .cursor-row:focus-visible .row-meta,
  .cursor-row:focus-visible .mark {
    color: var(--cursor-ink);
  }
  .cursor-row:hover::before,
  .cursor-row:focus-visible::before {
    color: var(--cursor-ink);
    opacity: 1;
  }
  .row-idx {
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }
  .row-title {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .row-date {
    color: var(--ink-dim);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row-meta {
    color: var(--ink-dim);
    font-size: 0.8125rem;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .block-side {
    padding: 0;
    border: 0;
  }
  .board-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .board-item {
    display: block;
    padding: 0.6rem 0.3rem;
    text-decoration: none;
    color: inherit;
  }
  .board-row + .board-row {
    border-top: 1px solid var(--line);
  }
  .board-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .board-name {
    font-weight: 700;
    transition: color 0.16s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .board-item:hover .board-name,
  .board-item:focus-visible .board-name {
    color: var(--accent);
  }
  .board-count {
    font-size: 0.8125rem;
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .board-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--ink-dim);
  }

  .statusbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: auto;
    padding: 0.6rem var(--gutter) 0;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .folio {
      grid-template-columns: 1fr;
    }
    .cursor-row {
      grid-template-columns: 2.5ch minmax(0, 1fr);
    }
    .row-date,
    .row-meta {
      grid-column: 2;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-row,
    .board-row {
      animation: light-up 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .post-row:nth-child(1) {
      animation-delay: 0.05s;
    }
    .post-row:nth-child(2) {
      animation-delay: 0.11s;
    }
    .post-row:nth-child(3) {
      animation-delay: 0.17s;
    }
    .post-row:nth-child(4) {
      animation-delay: 0.23s;
    }
    .post-row:nth-child(5) {
      animation-delay: 0.29s;
    }
    .board-row:nth-child(1) {
      animation-delay: 0.05s;
    }
    .board-row:nth-child(2) {
      animation-delay: 0.11s;
    }
    .board-row:nth-child(3) {
      animation-delay: 0.17s;
    }
    .board-row:nth-child(4) {
      animation-delay: 0.23s;
    }
    @keyframes light-up {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
