---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListPosts from '@/components/ListPosts.vue'
import siteConfig from '@/site-config'
import type { PostKey } from '@/types'
import { getPosts } from '@/utils/posts'

const pathCollections: Record<string, PostKey> = {
  blogs: 'blog',
  notes: 'notes',
  talks: 'talks',
}

const pathTitles: Record<string, string> = {
  blogs: '博客',
  notes: '随记',
  talks: '分享',
}

export async function getStaticPaths() {
  const paths = siteConfig.page.blogLinks.map((nav) => {
    const href = nav.href.replace('/blog', '')
    return {
      params: {
        path: href === '' ? undefined : href.replace(/^\/+|\/+$/g, ''),
      },
    }
  })
  return paths
}

const { path } = Astro.params

const posts = await getPosts(undefined, pathCollections[path ?? ''] ?? 'blog')
const pageTitle = pathTitles[path ?? ''] ?? '博客'

function activeLink(pathname: string) {
  return Astro.url.pathname.replace(/\/+/g, '/').replace(/\/$/, '') === pathname
}
---

<BaseLayout title={pageTitle} description="文章列表">
  <div class="flex flex-col gap-2 sm:flex-row sm:gap-4 flex-wrap mb-8">
    {
      siteConfig.page.blogLinks.map((nav) => (
        <a
          aria-label={nav.text}
          class={`text-3xl font-bold ${activeLink(nav.href) ? 'opacity-100' : 'text-muted hover:opacity-70'}`}
          href={nav.href}
        >
          {nav.text}
        </a>
      ))
    }
  </div>
  <ListPosts list={posts} />
</BaseLayout>
