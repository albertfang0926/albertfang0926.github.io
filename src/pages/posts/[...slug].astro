---
import BaseLayout from '@/layouts/BaseLayout.astro'
import EntryHead from '@/components/EntryHead.astro'
import { render } from 'astro:content'
import { type CollectionPosts } from '@/types'
import { getAllPosts } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => {
    return {
      params: { slug: post.id },
      props: {
        post,
      },
    }
  })
}

type Props = { post: CollectionPosts }

const { post } = Astro.props
const { title, image, description, date, duration, tag } = post.data

const boardLabels: Record<string, string> = {
  blog: '博客',
  notes: '随记',
  talks: '分享',
}

const { Content } = await render(post)

function getDate(date: string) {
  return new Date(date).toISOString()
}
---

<BaseLayout title={title} description={description} pageType="article">
  <article class="entry">
    <EntryHead
      legend="文章"
      title={title}
      date={date ? getDate(date) : undefined}
      tag={tag}
      duration={duration}
      draft={post.data.draft}
      video={post.data.video}
      board={boardLabels[post.collection]}
    />
    <div class="prose">
      {
        image && (
          <p>
            <img width="640" height="360" src={image.src} alt={image.alt || ''} />
          </p>
        )
      }
      <Content />
    </div>
  </article>
</BaseLayout>
